{
  "expo": {
    "name": "Engram",
    "slug": "engram",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "engram",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F4F1",
    "android": {
      "package": "com.pavitra14.engram",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1F3FBF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Engram uses the microphone to record your voice notes."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "audio/*"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      "expo-font",
      "expo-build-properties",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Engram uses the microphone to record your voice notes.",
          "speechRecognitionPermission": "Engram transcribes your voice notes on this device.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
