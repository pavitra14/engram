{
  "expo": {
    "name": "Engram",
    "slug": "engram",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "engram",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F4F1",
    "android": {
      "package": "dev.pavitra.engram",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#1F3FBF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Engram uses the microphone to record your voice notes."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "video/*",
              "audio/*",
              "application/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*",
              "application/*"
            ]
          }
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Engram uses the microphone to record your voice notes.",
          "speechRecognitionPermission": "Engram transcribes your voice notes on this device.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-blob-util",
      [
        "expo-notifications",
        {
          "color": "#1F3FBF"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Engram shows today's events so you can take notes on them."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Engram saves the photos and videos you choose.",
          "cameraPermission": "Engram uses the camera when you scan paper into a note.",
          "microphonePermission": "Engram uses the microphone to record your voice notes."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickThought",
              "label": "Quick thought",
              "description": "Write or speak a thought without opening Engram first",
              "minWidth": "250dp",
              "minHeight": "56dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "Todo",
              "label": "To do",
              "description": "Your next to-dos, and a button to add a thought",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Memory",
              "label": "From your notes",
              "description": "An older note, a different one through the day",
              "minWidth": "250dp",
              "minHeight": "70dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 10800000
            }
          ]
        }
      ],
      [
        "./plugins/withAppQueries",
        {
          "packages": [
            "com.anthropic.claude",
            "com.openai.chatgpt"
          ]
        }
      ],
      [
        "./plugins/withQuickCapture",
        {
          "tileLabel": "New thought"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Engram uses Face ID to unlock your notes."
        }
      ],
      "expo-secure-store",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
